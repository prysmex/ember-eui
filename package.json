{
  "name": "root",
  "private": true,
  "scripts": {
    "build": "pnpm turbo build",
    "build:site": "pnpm turbo build --filter site",
    "build:packages": "pnpm turbo build --filter './packages/*'",
    "lint": "pnpm turbo lint",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "docs:api:check": "node scripts/generate-api-docs.mjs --check",
    "test": "pnpm turbo test",
    "start": "pnpm build:packages && concurrently 'npm:_start:*' --names '_start:'",
    "_start:site": "pnpm --filter site start",
    "_start:packages": "pnpm --stream -parallel --filter './packages/*' start --no-watch.clearScreen",
    "publish-packages": "pnpm build --filter './packages/*' && changeset version && changeset publish",
    "sync-injected": "node scripts/sync-injected.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@glint/core": "^1.5.2",
    "@pnpm/workspace.injected-deps-syncer": "1100.0.39",
    "concurrently": "^9.1.2",
    "prettier": "^3.0.3",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "turbo": "^2.11.4",
    "typescript": "^5.3.3"
  },
  "volta": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.6.0"
}
