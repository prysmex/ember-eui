{
  "extends": "@tsconfig/ember/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "declarationDir": "declarations",
    "rootDir": "./src",
    "skipLibCheck": true,
    "noEmitOnError": false,
    "types": [
      "ember-source/types",
      "@glint/ember-tsc/types"
    ],
    "plugins": [
      {
        "name": "@glint/tsserver-plugin"
      }
    ],
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": [
    "src/**/*",
    "unpublished-development-types/**/*"
  ]
}
