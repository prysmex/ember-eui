{
  "name": "@ember-eui/pikaday",
  "version": "14.1.1",
  "description": "ember-pikaday integration with @ember-eui/core",
  "keywords": [
    "ember-addon",
    "ember-pikaday",
    "@ember-eui"
  ],
  "repository": "https://github.com/prysmex/ember-eui",
  "license": "MIT",
  "author": "Alberto Cantu <betocantu93@gmail.com> (https://betocantu93.com)",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "concurrently 'npm:build:*'",
    "build:js": "rollup --config",
    "build:types": "ember-tsc",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "pnpm run build",
    "start": "concurrently 'npm:start:*'",
    "start:js": "rollup --config --watch",
    "start:types": "ember-tsc --watch",
    "test": "node ../../scripts/sync-injected.mjs && vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0",
    "test:dev": "vite dev"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pikaday.css": "./dist/pikaday.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@ember/render-modifiers": "^4.0.0",
    "@embroider/addon-shim": "^1.10.3",
    "@nullvoxpopuli/ember-composable-helpers": "^5.3.2",
    "decorator-transforms": "^2.3.0",
    "ember-modifier": "^4.2.0",
    "ember-pikaday": "^5.1.1",
    "ember-truth-helpers": "^5.0.0"
  },
  "peerDependencies": {
    "@ember-eui/core": "^14.0.0",
    "@glimmer/component": "^2.0.0",
    "ember-source": ">= 4.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-transform-class-static-block": "^7.20.0",
    "@babel/plugin-transform-typescript": "^7.12.13",
    "@babel/preset-typescript": "^7.18.6",
    "@ember-eui/core": "workspace:*",
    "@ember/optional-features": "^2.2.0",
    "@ember/test-helpers": "^5.2.1",
    "@ember/test-waiters": "^4.1.1",
    "@embroider/addon-dev": "8.4.0",
    "@embroider/compat": "^4.1.0",
    "@embroider/core": "^4.1.0",
    "@embroider/macros": "^1.20.1",
    "@embroider/test-setup": "^4.0.0",
    "@embroider/vite": "^1.1.5",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.0.0",
    "@glint/ember-tsc": "^1.11.6",
    "@glint/template": "^1.9.0",
    "@glint/tsserver-plugin": "^2.7.9",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@tsconfig/ember": "3.0.0",
    "@types/ember": "^4.0.4",
    "@types/ember__application": "^4.0.6",
    "@types/ember__array": "^4.0.4",
    "@types/ember__component": "^4.0.14",
    "@types/ember__controller": "^4.0.5",
    "@types/ember__debug": "^4.0.4",
    "@types/ember__destroyable": "^4.0.3",
    "@types/ember__engine": "^4.0.5",
    "@types/ember__error": "^4.0.3",
    "@types/ember__helper": "^4.0.3",
    "@types/ember__modifier": "^4.0.6",
    "@types/ember__object": "^4.0.6",
    "@types/ember__owner": "^4.0.4",
    "@types/ember__polyfills": "^4.0.2",
    "@types/ember__routing": "^4.0.13",
    "@types/ember__runloop": "^4.0.3",
    "@types/ember__service": "^4.0.3",
    "@types/ember__string": "^3.16.3",
    "@types/ember__template": "^4.0.2",
    "@types/ember__test": "^4.0.2",
    "@types/ember__utils": "^4.0.3",
    "@types/ember-resolver": "^5.0.11",
    "@types/qunit": "^2.19.12",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.1.2",
    "ember-basic-dropdown": "^9.0.0",
    "ember-cli": "~6.1.0",
    "ember-cli-clean-css": "^3.0.0",
    "ember-concurrency": "^5.1.0",
    "ember-focus-trap": "^1.1.0",
    "ember-keyboard": "^9.0.4",
    "ember-power-select": "^9.0.2",
    "ember-qunit": "^9.0.2",
    "ember-source": "~6.12.0",
    "ember-strict-application-resolver": "^0.1.1",
    "ember-template-lint": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^16.5.0",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.4.0",
    "rollup": "^4.6.0",
    "rollup-plugin-copy": "^3.5.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-prettier": "^5.0.2",
    "testem": "^3.15.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.9",
    "webpack": "^5.97.1"
  },
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "access": "public"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/eui-pikaday.js": "./dist/_app_/components/eui-pikaday.js"
    }
  },
  "volta": {
    "extends": "../../package.json"
  }
}
