{
  "name": "site",
  "version": "14.1.3",
  "private": true,
  "description": "Documentation site for Ember EUI",
  "repository": "https://github.com/prysmex/ember-eui",
  "license": "MIT",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "node ../scripts/sync-injected.mjs && node ../scripts/generate-llms-txt.mjs && vite build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "node ../scripts/generate-llms-txt.mjs && concurrently 'vite' 'node ../scripts/sync-injected.mjs --watch' --names 'site,sync'",
    "test": "node ../scripts/sync-injected.mjs && vite build --mode development && testem ci --port 0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@docfy/core": "^0.14.2",
    "@docfy/ember": "^0.14.2",
    "@docfy/ember-vite": "^0.14.2",
    "@ember-eui/changeset-form": "workspace:*",
    "@ember-eui/core": "workspace:*",
    "@ember-eui/flatpickr": "workspace:*",
    "@ember-eui/pikaday": "workspace:*",
    "@ember-eui/validated-form": "workspace:*",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/optional-features": "^3.0.0",
    "@ember/render-modifiers": "^4.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.25",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.1",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.13",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.11.4",
    "@glint/template": "^1.9.0",
    "@glint/tsserver-plugin": "^2.7.7",
    "@nullvoxpopuli/ember-composable-helpers": "^5.3.2",
    "@rollup/plugin-babel": "^7.1.0",
    "@svg-jar/plugin": "0.2.1",
    "@types/qunit": "^2.19.14",
    "@types/rsvp": "^4.0.9",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.4",
    "decorator-transforms": "^2.4.0",
    "ember-basic-dropdown": "^9.0.0",
    "ember-changeset": "^5.0.0",
    "ember-changeset-validations": "^5.0.0",
    "ember-cli": "~7.3.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-concurrency": "^5.1.0",
    "ember-focus-trap": "^1.1.0",
    "ember-intl": "^9.1.0",
    "ember-keyboard": "^9.0.4",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-power-select": "^9.0.2",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-set-helper": "^3.1.0",
    "ember-source": "~7.3.0",
    "ember-template-lint": "^7.9.3",
    "ember-truth-helpers": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "flatpickr": "^4.6.13",
    "globals": "^16.5.0",
    "moment": "^2.29.3",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "testem": "^3.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "ember": {
    "edition": "octane"
  },
  "volta": {
    "extends": "../package.json"
  }
}
