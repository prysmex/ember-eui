{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": [
        "^dev"
      ],
      "cache": false
    },
    "start": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [
        "dist/**",
        "dist-types/**",
        "declarations/**",
        "docs.json"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": false
    }
  }
}
